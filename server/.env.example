# Supabase project → Settings → API. The service-role key is secret: server only, never in the frontend.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

JWT_SECRET=<long random string>
JWT_EXPIRATION=7d
FRONTEND_URL=http://localhost:5177

# Optional: online payments are only offered when real keys are set
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Optional: first admin account created by the seed
ADMIN_EMAIL=admin@lustre.com
ADMIN_PASSWORD=Admin@123

# Google OAuth 2.0 Client Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Abandoned Cart Recovery & Email Settings
STOREFRONT_URL=http://localhost:5173
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=Lustre & Co. <no-reply@example.com>

# Shipping Origin & Provider Configuration
STORE_NAME="Lustre & Co."
STORE_PHONE="+91 98765 43210"
STORE_ADDRESS="123 Luxury Avenue, Bandra West"
STORE_CITY="Mumbai"
STORE_STATE="Maharashtra"
STORE_PINCODE="400050"

# Shipping Integration & Carrier Providers
SHIPPING_DEFAULT_PROVIDER=local_delivery

# Shiprocket
SHIPROCKET_API_URL=https://apiv2.shiprocket.in/v1/external
SHIPROCKET_TOKEN=
SHIPROCKET_WEBHOOK_SECRET=

# Delhivery
DELHIVERY_API_URL=https://track.delhivery.com/api
DELHIVERY_TOKEN=
DELHIVERY_WEBHOOK_SECRET=

# Blue Dart
BLUE_DART_API_URL=https://api.bluedart.com
BLUE_DART_TOKEN=
BLUE_DART_WEBHOOK_SECRET=

# Easyship
EASYSHIP_API_URL=https://api.easyship.com/v2
EASYSHIP_TOKEN=
EASYSHIP_WEBHOOK_SECRET=

# Shippo
SHIPPO_API_URL=https://api.goshippo.com
SHIPPO_TOKEN=
SHIPPO_WEBHOOK_SECRET=

# Company Legal Details & Invoicing
COMPANY_LEGAL_NAME="Lustre & Co. Luxury Jewels Private Limited"
COMPANY_CIN=U36911MH2024PTC123456
COMPANY_GSTIN=27AABCL1234F1Z8
COMPANY_PAN=AABCL1234F
