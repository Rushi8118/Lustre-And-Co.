# Supabase project → Settings → API. The service-role key is secret: server only, never in the frontend.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

JWT_SECRET=<long random string>
JWT_EXPIRATION=7d
FRONTEND_URL=http://localhost:5177

# Optional: online payments are only offered when real keys are set
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Set this to the secret you choose when creating the webhook in the Razorpay dashboard
RAZORPAY_WEBHOOK_SECRET=

# Optional: first admin account created by the seed
ADMIN_EMAIL=admin@lustre.com
ADMIN_PASSWORD=Admin@123
